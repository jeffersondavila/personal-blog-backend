# ---------------------------------------------------------------------------
# personal-blog-backend — Variables de entorno (ejemplo)
#
# Copia este archivo a `.env` y ajusta los valores:
#
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# `.env` esta ignorado por Git. Este archivo `.env.example` SI se versiona y
# por tanto NO contiene ninguna credencial real: todos los valores de abajo son
# ficticios (requisito S-10).
#
# Todas las variables usan el prefijo BLOG_. La configuracion se valida al
# arrancar: si falta una obligatoria o un valor no es valido, el proceso no
# arranca (requisito T-01).
#
# En la nube estas mismas variables provienen de AWS SSM Parameter Store; el
# codigo no distingue el origen.
# ---------------------------------------------------------------------------

# --- Aplicacion ------------------------------------------------------------

# Nombre del servicio. Aparece en OpenAPI, en /health y en los logs.
BLOG_APP_NAME=personal-blog-backend

# Entorno de ejecucion: local | test | production
BLOG_APP_ENV=local

# Modo depuracion. Deshabilitado por defecto; prohibido con BLOG_APP_ENV=production.
BLOG_APP_DEBUG=false

# Prefijo de la API versionada (docs/architecture/api-contracts.md).
# /health queda FUERA de este prefijo: es una sonda de plataforma, no parte del
# contrato de datos con el frontend.
BLOG_API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Origen publico del SITIO. Anadido por `Task/016`.
#
# OBLIGATORIA y sin valor por defecto, como BLOG_DATABASE_URL y
# BLOG_STORAGE_BUCKET: sin ella el proceso NO arranca (requisito T-01).
#
# No es el origen del API, y esa es justo la distincion que evita el error:
# `sitemap.xml` (requisito E-05) enumera URL del SITIO PUBLICO. Un sitemap que
# listara `https://api.ejemplo.test/articulos/x` seria falso, porque esa
# direccion no sirve la pagina.
#
# Tampoco se puede deducir de la peticion: `Host` lo escribe el cliente y,
# detras de un proxy o de API Gateway, nombra el API y no el sitio. Con la
# topologia de D-15 el sitio vive en el dominio raiz y el API en un subdominio.
#
# Se valida al arrancar: URL absoluta, esquema http o https, sin barra final.
# Fail-closed: un origen invalido rompe el arranque, no la primera peticion al
# sitemap.
#
# **No fija ningun dominio de produccion.** El dominio concreto es la decision
# D-07, abierta hasta `Task/035`.
#
# En local coincide con el origen del sitio que sirve Traefik (`Task/007`),
# porque el proxy enruta por prefijo de ruta y comparten origen.
BLOG_PUBLIC_SITE_BASE_URL=http://localhost:8081

# --- Observabilidad --------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
BLOG_LOG_LEVEL=INFO

# json | text — `json` es el formato del proyecto (requisito O-01).
# `text` solo para depuracion manual en una terminal.
BLOG_LOG_FORMAT=json

# --- PostgreSQL ------------------------------------------------------------

# OBLIGATORIA. Sin ella el proceso no arranca.
#
# Formato: postgresql://<usuario>:<contrasena>@<host>:<puerto>/<base>
#
# Valores del entorno local levantado por personal-blog-infra
# (docker-compose.yml + .env de ese repositorio):
#
#   usuario   POSTGRES_USER del .env de infra      (por defecto blog_local)
#   base      POSTGRES_DB del .env de infra        (por defecto personal_blog)
#   host      127.0.0.1 desde la maquina host
#             personal-blog-local-postgres desde otro contenedor de la red
#             personal-blog-local-data
#   puerto    55432 desde el host, 5432 dentro de la red de Docker
#
# La contrasena de abajo es FICTICIA. Sustituyela en tu `.env` por la que hayas
# puesto en el `.env` de personal-blog-infra. Nunca la escribas aqui.
BLOG_DATABASE_URL=postgresql://blog_local:change-me-local-postgres@127.0.0.1:55432/personal_blog

# --- Pool de conexiones ----------------------------------------------------
#
# Valores validos para la ejecucion local. La estrategia definitiva para AWS
# Lambda —conexiones cortas, proxy o pooler externo— se decide en `Task/029`.

BLOG_DATABASE_POOL_SIZE=5
BLOG_DATABASE_POOL_MAX_OVERFLOW=5
BLOG_DATABASE_POOL_RECYCLE_SECONDS=1800
BLOG_DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Registro de las sentencias SQL. Mantener en false: las sentencias pueden
# contener datos sensibles (requisito S-08). Prohibido con BLOG_APP_ENV=production.
BLOG_DATABASE_ECHO=false

# --- Almacenamiento de objetos (`Task/010`) --------------------------------
#
# La aplicacion depende de la interfaz `ObjectStorage`. Estas variables son lo
# unico que decide que implementacion la satisface: `MinIOStorage` en local y
# `S3Storage` en produccion (docs/architecture/software-architecture.md 3.7).
#
# En produccion provienen de AWS SSM Parameter Store; el codigo no distingue el
# origen. La integracion con SSM es de `Task/032`.

# minio | s3
# `minio` esta PROHIBIDO con BLOG_APP_ENV=production: es el almacenamiento del
# entorno local, y el proceso no arranca con esa combinacion.
BLOG_STORAGE_PROVIDER=minio

# OBLIGATORIA. Sin ella el proceso no arranca: no existe un valor por defecto
# seguro, y equivocarlo significaria escribir donde no toca.
#
# El bucket lo crea el entorno local; en produccion lo crea Terraform
# (`Task/030`). El adaptador NUNCA crea un bucket por su cuenta.
BLOG_STORAGE_BUCKET=personal-blog-media

# Region declarada al firmar. MinIO acepta cualquiera; en S3 determina ademas
# el endpoint cuando no se declara uno.
BLOG_STORAGE_REGION=us-east-1

# Endpoint del servicio compatible con S3.
#
#   OBLIGATORIO con `minio`.
#   Se OMITE con `s3` en produccion, para que el SDK resuelva el de AWS.
#
# Desde la maquina host: 127.0.0.1:9000
# Desde otro contenedor de la red personal-blog-local-data:
#   http://personal-blog-local-minio:9000
#
# `MinIOStorage` RECHAZA cualquier endpoint de amazonaws.com: es el adaptador
# local y una variable mal puesta no debe poder convertirlo en un cliente de
# produccion.
BLOG_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000

# Endpoint DE ACCESO: el anfitrion que aparece en el enlace temporal con el que
# se sirve una imagen (`access_url`).
#
# Solo hace falta cuando el consumidor del enlace NO ve el mismo anfitrion que
# el backend. Ese es exactamente el caso dentro de Docker Compose:
#
#   backend  -> MinIO   : http://minio:9000        (nombre de servicio)
#   navegador -> MinIO   : http://localhost:9000   (puerto publicado en el host)
#
# El anfitrion forma parte de la firma AWS Signature Version 4, asi que un
# enlace firmado contra `minio:9000` NO se puede corregir despues cambiandole
# el host: la firma quedaria invalida (403 SignatureDoesNotMatch). Por eso este
# endpoint participa en la firma desde el principio.
#
# Ejecutando el backend DIRECTAMENTE en el host, los dos coinciden y esta
# variable se puede omitir: entonces se firma contra el endpoint operativo.
#
# En produccion se OMITE: con `s3`, el SDK resuelve el endpoint de AWS y firma
# contra el. Una URL estable, un dominio propio o un CDN son de `Task/030`.
# BLOG_STORAGE_ACCESS_ENDPOINT_URL=http://localhost:9000

# Credenciales del almacenamiento.
#
#   OBLIGATORIAS con `minio`.
#   Se OMITEN con `s3` en produccion: alli las aporta el rol de ejecucion de la
#   Lambda, que es preferible a una credencial estatica (requisito S-01).
#
# Las de abajo son FICTICIAS. Sustituyelas en tu `.env` por MINIO_ROOT_USER y
# MINIO_ROOT_PASSWORD del `.env` de personal-blog-infra. Nunca las escribas aqui.
BLOG_STORAGE_ACCESS_KEY=blog_minio_local
BLOG_STORAGE_SECRET_KEY=change-me-local-minio

# Validez del enlace temporal con el que se sirve una imagen, en segundos.
# Entre 60 y 604800; por defecto 900 (15 minutos).
#
# La politica de expiracion DEFINITIVA de produccion es de `Task/030` (D-08).
# Aqui es configuracion a proposito: enterrarla en el adaptador la haria
# inamovible sin tocar codigo.
BLOG_STORAGE_ACCESS_TTL_SECONDS=900

# --- Autenticacion administrativa (`Task/011`) -----------------------------
#
# NO HAY NINGUN SECRETO EN ESTA SECCION, y no es un descuido: la autenticacion
# elegida —sesion opaca en el servidor con cookie HttpOnly, decision D-011-B—
# no firma nada, asi que no existe ningun `JWT_SECRET` ni `AUTH_SECRET` que
# custodiar, rotar o filtrar. Reservar uno "por si acaso" solo anadiria
# superficie sin uso.
#
# Todas estas variables tienen un valor por defecto seguro: el backend arranca
# sin declarar ninguna. Se documentan para que su existencia no haya que
# descubrirla leyendo el codigo.

# Duracion ABSOLUTA de la sesion administrativa, en segundos. Entre 60 y 604800;
# por defecto 43200 (12 h). No hay renovacion deslizante ni caducidad por
# inactividad: la sesion vive lo que dura y despues se vuelve a iniciar.
BLOG_AUTH_SESSION_TTL_SECONDS=43200

# Marca `Secure` de la cookie de sesion.
#
# Por defecto `true`, y con BLOG_APP_ENV=production el valor `false` IMPIDE
# ARRANCAR: en produccion la cookie viaja por Internet y sin `Secure` podria
# acabar en una peticion en claro.
#
# En el entorno local, que sirve por HTTP, hay que ponerlo en `false` o el
# navegador no guardara la cookie.
BLOG_AUTH_COOKIE_SECURE=false

# Proteccion contra fuerza bruta SOBRE LA CUENTA.
#
# Tras BLOG_AUTH_MAX_FAILED_ATTEMPTS fallos consecutivos, la cuenta queda
# bloqueada durante BLOG_AUTH_LOCKOUT_SECONDS. El bloqueo NUNCA es permanente:
# hay un solo administrador y dejarlo fuera para siempre seria peor que el
# ataque. Al vencer, el contador empieza de nuevo.
#
# Nota: mientras la cuenta esta bloqueada, la API responde exactamente igual que
# ante unas credenciales invalidas. Es deliberado —distinguirlo permitiria
# averiguar que ese correo existe— y tiene un precio: el propietario que se
# bloquee a si mismo vera "credenciales invalidas". El motivo real queda en la
# auditoria y en el log.
BLOG_AUTH_MAX_FAILED_ATTEMPTS=5
BLOG_AUTH_LOCKOUT_SECONDS=900

# Limite de tasa DEL ENDPOINT DE ACCESO, por direccion de cliente.
#
# Es una proteccion distinta del bloqueo de cuenta y ninguna sustituye a la
# otra: esta acota rafagas desde un origen; aquella, la adivinacion de una
# contrasena concreta.
#
# El contador vive en PostgreSQL —tabla `login_rate_limits`— y por eso es
# COMPARTIDO entre instancias, que es lo que exige un backend sin estado. La
# ventana es fija: en su frontera admite hasta el doble del limite.
BLOG_AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
BLOG_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Origenes del panel administrativo, separados por comas. NUNCA `*`.
#
# ES LA CONFIGURACION MAS FACIL DE PASAR POR ALTO. Con la lista vacia —el valor
# por defecto— cualquier peticion de navegador que CAMBIE ESTADO bajo
# /api/v1/admin (iniciar y cerrar sesion) se rechaza con `403`. Es fail-closed a
# proposito: no existe un origen por defecto que sea seguro suponer.
#
# Las lecturas (`GET /admin/auth/me`) no se ven afectadas, y un cliente que no
# sea un navegador —curl, un script— tampoco: sin cabecera `Origin` no hay
# falsificacion de peticion posible.
#
# Es la segunda capa de la defensa CSRF; la primera es `SameSite=Lax`.
#
# Formato: esquema://anfitrion[:puerto], sin ruta ni barra final. Un valor mal
# formado IMPIDE ARRANCAR.
#
# Ejemplo para el panel servido por Vite en el entorno local:
# BLOG_ADMIN_ALLOWED_ORIGINS=http://localhost:5173
#
# Los nombres de dominio reales se deciden en `Task/035`; la topologia logica
# —sitio en el dominio raiz, API en un subdominio— es la decision D-011-A.
BLOG_ADMIN_ALLOWED_ORIGINS=

# Numero de proxies de CONFIANZA delante del backend.
#
# Con 0 —el valor por defecto— se IGNORA `X-Forwarded-For` por completo y se usa
# la direccion del par TCP. Esa cabecera la escribe cualquier cliente, y
# creersela sin un proxy delante permitiria enviar una direccion distinta en
# cada intento y anular el limite de tasa.
#
# Con n>0 se toma el valor n-esimo EMPEZANDO POR LA DERECHA, que es el que
# anadio el proxy de confianza mas externo. El valor correcto detras de Traefik
# o de API Gateway lo fijan el runbook del entorno local y `Task/033`.
BLOG_TRUSTED_PROXY_HOP_COUNT=0

# --- Pruebas de integracion (NO es una variable de la aplicacion) ----------
#
# La usan solo las pruebas de `tests/integration/`. No lleva prefijo BLOG_ a
# proposito: la suite limpia ese prefijo del entorno para aislarse de la
# configuracion de la maquina, y esta variable debe sobrevivir a esa limpieza.
#
# NO la definas en este `.env`: exportala en tu terminal cuando quieras
# ejecutar la integracion. Se documenta aqui para que su existencia no se
# descubra leyendo el codigo.
#
# ADVERTENCIA: las pruebas de integracion son DESTRUCTIVAS. Ejecutan
# `alembic downgrade base`. Debe apuntar SIEMPRE a la base dedicada de
# pruebas, NUNCA a `personal_blog`.
#
# La base debe existir y llevar la marca `personal-blog:test-database` en su
# comentario de PostgreSQL. Procedimiento completo:
# personal-blog-infra/docs/runbooks/local-environment.md seccion 9.
#
#   $env:PERSONAL_BLOG_TEST_DATABASE_URL="postgresql://<usuario>:<clave>@127.0.0.1:55432/personal_blog_test"

# Almacenamiento de pruebas (`Task/010`). Mismas dos reglas: sin
# PERSONAL_BLOG_TEST_STORAGE_ENDPOINT_URL la integracion de MinIO se OMITE; con
# ella, cualquier fallo es FAIL.
#
# ADVERTENCIA: la suite CREA Y BORRA un bucket entero. Por eso la guarda solo
# acepta anfitriones locales y solo borra buckets con el prefijo
# `personal-blog-test-`, que crea ella misma. El bucket de desarrollo de
# BLOG_STORAGE_BUCKET nunca es alcanzable como destino.
#
#   $env:PERSONAL_BLOG_TEST_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
#   $env:PERSONAL_BLOG_TEST_STORAGE_ACCESS_KEY="<MINIO_ROOT_USER del .env de infra>"
#   $env:PERSONAL_BLOG_TEST_STORAGE_SECRET_KEY="<MINIO_ROOT_PASSWORD del .env de infra>"
