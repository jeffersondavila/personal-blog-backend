; personal-blog-backend
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{pyi,pyx}]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{toml,cfg,ini}]
indent_size = 4

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

[{Dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2

; Excepcion tecnica: `cmd.exe` puede interpretar mal etiquetas y `goto` si el
; archivo llega con LF. `.gitattributes` declara `eol=crlf` para estas
; extensiones; sin esta seccion, el `[*]` de arriba impondria LF desde el editor
; y habria dos politicas para el mismo archivo. Anadido en Task/005.7.
[*.{bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
